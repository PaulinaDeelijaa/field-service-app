{
  "expo": {
    "name": "Field Service",
    "slug": "field-service-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fieldservice",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fieldservice.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph job sites and equipment.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to task reports."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.fieldservice.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to photograph job sites and equipment."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to attach photos to task reports."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
